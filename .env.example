# =============================================================================
# Smart Inventory & Warehouse Platform - Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   Copy-Item .env.example .env
# =============================================================================

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smart_inventory
DB_USERNAME=smartinv_user
DB_PASSWORD=your_secure_db_password_here
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here

# JWT Authentication
# Secret must be at least 32 bytes (256 bits).
# Generate on PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 } | ForEach-Object { [byte]$_ }))
# Or on Linux/macOS:
#   openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_bytes_here
JWT_EXPIRATION_MS=3600000

# Bootstrap Initial Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=your_initial_admin_password_here
